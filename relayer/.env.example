# Verified live 2026-09-08 against Hedera's mirror node and on-chain via cast —
# see docs/CHAINS.md and docs/DEPLOYMENTS.md. Additive and off by default —
# set ENABLE_HEDERA=true to include Hedera in the route table. Fast pool only:
# Hedera has no CCTP support. USDC on Hedera does NOT implement EIP-3009 —
# deposits use approve() + deposit(), not a signed permit, so this is not
# gasless for the payer on this chain (see docs/CHAINS.md "Hedera").
ENABLE_HEDERA=false
HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api
HEDERA_TESTNET_SOURCE_VAULT_ADDRESS=0xfd80365F46C776eE7c08642F700E268e69247228
HEDERA_TESTNET_DEST_POOL_ADDRESS=0xD2B5A9a82B91a60eb7AD28770a5453546746b8f6
HEDERA_TESTNET_USDC_ADDRESS=0x0000000000000000000000000000000000068cda

# Verified live 2026-09-08 against docs.arc.io and on-chain via cast — see
# docs/CHAINS.md and docs/DEPLOYMENTS.md. Additive and off by default —
# set ENABLE_ARC=true to include Arc in the route table.
ENABLE_ARC=false
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_TESTNET_SOURCE_VAULT_ADDRESS=0xfd2f67cD354545712f9d8230170015d7e30d133A
ARC_TESTNET_DEST_POOL_ADDRESS=0xA5dd225Beb2Ec0009Fe143eb0B9309Ba07d23737
ARC_TESTNET_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# CCTP V2 — same addresses on every Sepolia testnet (verified on-chain against
