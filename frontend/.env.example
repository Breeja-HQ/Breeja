# Relayer HTTP + SSE API base URL — browser-visible, used for the SSE stream
# and direct GET /chains reads (both unauthenticated on the relayer).
NEXT_PUBLIC_RELAYER_API_URL=http://localhost:3001

# Server-only: used by app/api/quote and app/api/pay to proxy authenticated
# calls to the relayer without exposing the key to the browser. Never prefix
# with NEXT_PUBLIC_.
RELAYER_API_URL=http://localhost:3001
BREEJA_API_KEY=

# Comma-separated subgraph query endpoints for the live stats bar and
# /dashboard — one per chain, queried in parallel and merged client-side
# (per docs/PARTNERS.md, there is no single endpoint spanning every chain).
# Leave unset to show the skeleton/empty states — never fake zeros.
NEXT_PUBLIC_SUBGRAPH_URLS=

# WalletConnect / RainbowKit project id
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Privy app id for embedded-wallet / email+social login, from the App
# settings page of a Privy dashboard app. PrivyProvider is skipped entirely
# when unset, so the Privy connect button and embedded-wallet signer stay
# inert rather than erroring, but a real integration needs a real app id here.
NEXT_PUBLIC_PRIVY_APP_ID=

# Chain addresses (SourceVault, DestPool, USDC) live in lib/chains.ts, sourced
# from docs/DEPLOYMENTS.md — not duplicated here as env vars.
